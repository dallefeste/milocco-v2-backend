# Database PostgreSQL dell'applicazione (docker compose lo crea con questi valori)
DB_HOST=localhost
DB_PORT=5440
DB_NAME=milocco
DB_USER=milocco
DB_PASSWORD=milocco

# Backend
API_PORT=3100
# Chiave per firmare i token di accesso: in produzione una stringa casuale lunga
JWT_SECRET=cambiami-in-produzione
JWT_EXPIRES_IN=12h
# Utente amministratore creato al primo avvio se non esiste nessun amministratore
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Cartella dove si salvano i file caricati (preventivi Excel, allegati)
STORAGE_DIR=./storage
# Origini web autorizzate a chiamare l'API (backoffice e tablet in sviluppo)
CORS_ORIGINS=http://localhost:5180,http://localhost:5181

# Import dati dal vecchio database MySQL (solo per la migrazione iniziale)
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=milocco_backoffice
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
# Username del vecchio sistema da non importare (separati da virgola)
LEGACY_SKIP_USERS=
# Dominio email del personale: gli account con email di altri domini non vengono importati
LEGACY_COMPANY_EMAIL_DOMAIN=
